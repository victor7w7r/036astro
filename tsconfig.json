{
  "compilerOptions": {
    "baseUrl": ".",
    "experimentalDecorators": true,
    "isolatedModules": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "noEmit": true,
    "paths": {
      "@/*": ["src/features/*"],
      "~/*": ["src/core/*"]
    },
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "target": "ESNext",
    "useDefineForClassFields": false
  },
  "extends": "./tsconfig.app.json",
  "include": [".astro/types.d.ts", "src", "test"],
  "exclude": ["dist"]
}
