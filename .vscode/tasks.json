{
  "version": "2.0.0",
  "tasks": [
    {
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "type": "shell",
      "command": "bun",
      "args": ["tsc", "-p", "tsconfig.json", "--watch"],
      "label": "tsc: inspección: tsconfig.json",
      "problemMatcher": ["$tsc-watch"],
      "runOptions": {
        "runOn": "folderOpen"
      },
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      }
    }
  ]
}
