<Layout>
  <main>
    <a data-turbo='true' href='/page'>Pagina2</a>
    <div data-turbo-permanent id='element'>
      <h3>Lit</h3>
      <lit-element></lit-element>
      <br />
    </div>
    <h3>Stimulus</h3>
    <div data-controller='counter' data-turbo-permanent id='stimulus'>
      <button data-action='click -> counter#increment' data-counter-target='btn'
      ></button>
    </div>
    <br />
    <!---
    <div data-turbo-permanent id='svelteelement'>
      <h3>Svelte Element</h3>
      <svelte-element></svelte-element>
    </div>  -->
    <div>
      <Common client:load />
    </div>
  </main>
</Layout>
